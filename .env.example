# for OpenAI LLM
# change key and model to your desired one
JOINLY_LLM_MODEL=gpt-4o
JOINLY_LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
# for Anthropic LLM
# change key and model to your desired one
JOINLY_LLM_MODEL=claude-3-5-haiku-latest
JOINLY_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# for Google LLM
# change key and model to your desired one
JOINLY_MODEL_NAME=gemini-2.5-flash-lite
JOINLY_MODEL_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key

# for Azure OpenAI LLM
# change key and model to your desired one (and version)
JOINLY_LLM_MODEL=gpt-4o
JOINLY_LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview

# for Ollama LLM (requires ollama pull <model>)
# Note: only works when using the client_example.py, or another script outside of the docker,
# for direct usage with --client, you would need additional setup
# note that small models often fail to correctly call the necessary tools, so try with caution
# change to your desired model with tool calling
JOINLY_LLM_MODEL=smollm2:1.7b
JOINLY_LLM_PROVIDER=ollama
# for Ollama at a different host, set following variables to your desired host and port:
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434

# Deepgram Text-to-Speech/Transcription, set args "--tts deepgram" or/and "--stt deepgram"
DEEPGRAM_API_KEY=your-deepgram-api-key

# ElevenLabs Text-to-Speech, set arg "--tts elevenlabs"
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Resemble AI Text-to-Speech, set arg "--tts resemble"
RESEMBLE_API_KEY=your-resemble-ai-api-key

# For the example client (tavily web search)
TAVILY_API_KEY=your-tavily-api-key

# ---------------------------------------------------------------------------
# GPT-Live voice mode (--voice-mode gpt-live), see README "GPT-Live mode"
# OPENAI_API_KEY (above) is required; the project needs access to gpt-live-1
# and the backend model.
# ---------------------------------------------------------------------------
JOINLY_VOICE_MODE=gpt-live
JOINLY_NAME=Helios
JOINLY_LANGUAGE=en
# seconds to wait in the Teams lobby before exiting (exit code 3)
JOINLY_LOBBY_TIMEOUT=300

# voice (frontend) model
JOINLY_GPT_LIVE_MODEL=gpt-live-1
JOINLY_GPT_LIVE_VOICE=marin
# ASR spellings of the name that also count as addressing the agent
JOINLY_GPT_LIVE_NAME_ALIASES=helius,helio's,helio,elios,helias,hey leos,hilios
# chat token that addresses the agent (default: @<name>)
JOINLY_GPT_LIVE_CHAT_TRIGGER=@helios
# stay audible this long after being addressed / after last speaking
JOINLY_GPT_LIVE_FOLLOWUP_SECONDS=20
# hold unaddressed model audio this long in case the name arrives late
JOINLY_GPT_LIVE_HOLD_SECONDS=1.5
# continuous human speech (ms) that interrupts the agent
JOINLY_GPT_LIVE_BARGEIN_MS=800
JOINLY_GPT_LIVE_DISCLOSURE=true

# delegated (backend) model, run by OpenAI via Responses delegation
JOINLY_BACKEND_MODEL=gpt-5.6-terra
JOINLY_BACKEND_REASONING_EFFORT=low
# auto | default | flex | priority (Fast mode, if your project has access)
JOINLY_BACKEND_SERVICE_TIER=auto
JOINLY_BACKEND_WEB_SEARCH=false
JOINLY_BACKEND_TOOL_TIMEOUT=10

# Optional: joinly-backend tool server for your own business tools.
# Leave unset to use only the built-in meeting tools (transcript, chat,
# participants, screen snapshot). docker-compose sets the URL automatically.
# JOINLY_TOOLS_URL=http://backend:8080
# shared secret between joinly and joinly-backend; generate e.g. `openssl rand -hex 32`
# JOINLY_BACKEND_TOKEN=change-me
